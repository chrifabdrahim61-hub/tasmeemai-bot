# Copy this file, rename the copy to .env, and paste your real token.
# Get a token from @BotFather on Telegram.
BOT_TOKEN=123456789:PASTE_YOUR_TOKEN_HERE

# --- Step 7: growth & monetization (defaults shown, all optional) ----------

# Support contact shown by /help, /support and the menu button.
SUPPORT_HANDLE=@vxgix

# Owner accounts (Step 8): your Telegram NUMERIC ID(s), comma-separated.
# They unlock the hidden /admin dashboard: /admin add <user_id> <amount>.
ADMIN_IDS=8974969463

# Channel every user must join before using the bot (force-subscribe).
# IMPORTANT: add your bot to this channel as ADMIN, otherwise the
# membership check fails and the gate fails open (nobody is blocked).
REQUIRED_CHANNEL=@gifthubai
# Set to 0 to disable the force-subscribe gate entirely.
FORCE_SUBSCRIBE=1

# Credits economy.
START_CREDITS=5      # granted once, at the very first /start
DAILY_REFILL=3       # added back automatically every UTC day
REFERRAL_BONUS=2     # per friend who starts the bot through your link
GENERATION_COST=1    # per generated prompt

# Donation buttons under the output (Telegram Stars, currency XTR).
DONATE_AMOUNTS=25,50,75,100

# Storage: SQLite database file (created automatically). Do not set
# TASMEEM_DB in production; it exists for tests (":memory:").
#TASMEEM_DB=data/tasmeem.db
